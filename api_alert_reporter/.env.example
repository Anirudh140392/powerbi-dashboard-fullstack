# ==============================================================================
# API Alert Email Reporter Configuration
# Fill in your credentials and rename/copy this file to .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Sender Account (Office 365 Outlook SMTP)
# ------------------------------------------------------------------------------
# Sender address that delivers the automated daily report
SENDER_EMAIL=business@trailytics.com
# Office 365 password or App Password (if Multi-Factor Authentication is enabled)
# Note: Ensure Authenticated SMTP (SMTP AUTH) is enabled for this mailbox in M365 Admin Center
SENDER_PASSWORD=

# SMTP Server details
SMTP_HOST=smtp.office365.com
SMTP_PORT=587

# Optional sender display name
SENDER_DISPLAY_NAME=Trailytics API Monitor

# ------------------------------------------------------------------------------
# ClickHouse Database Configuration
# ------------------------------------------------------------------------------
CLICKHOUSE_URL=http://13.200.55.131:8123
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=admin_master

# Table names (if customized)
API_LOGS_TABLE=api_logs
API_ALERT_TABLE=api_alert

# ------------------------------------------------------------------------------
# Report Scope & Filtering Options
# ------------------------------------------------------------------------------
# DATE_SCOPE options:
#   latest    - (Recommended) Queries the latest date present in api_logs (e.g. today's logs)
#   today     - Queries logs strictly matching today's calendar date in IST
#   yesterday - Queries logs strictly matching yesterday's calendar date in IST
#   both      - Queries both days present in the retention window (yesterday + today)
DATE_SCOPE=latest

# Whether to send an email when zero issues (0 failed & 0 empty) are detected
# false = do not send anything, log informational notice
# true  = send a brief "All APIs healthy" notice
SEND_IF_NO_ISSUES=false

# Number of recipients to include per BCC batch (Office 365 safe limit: 50)
RECIPIENT_BATCH_SIZE=50

# ------------------------------------------------------------------------------
# Scheduler Settings
# ------------------------------------------------------------------------------
# Daily execution time in HH:MM (24-hour format)
SCHEDULE_TIME=09:00
# Target timezone
TIMEZONE=Asia/Kolkata
